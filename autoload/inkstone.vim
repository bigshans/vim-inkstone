" variant -> terminal ANSI (16) colours, straight from the VS Code theme
let s:term_cache = {}
let s:term_table = []
" truecolor 终端不需要逐色计算 xterm-256 近似值（冷启动时占了绝大部分耗时）
let s:truecolor = 0

function! s:build_term_table() abort
  if !empty(s:term_table)
    return
  endif
  let s:term_table = [
        \ [0, 0, 0], [128, 0, 0], [0, 128, 0], [128, 128, 0],
        \ [0, 0, 128], [128, 0, 128], [0, 128, 128], [192, 192, 192],
        \ [128, 128, 128], [255, 0, 0], [0, 255, 0], [255, 255, 0],
        \ [0, 0, 255], [255, 0, 255], [0, 255, 255], [255, 255, 255]]
  let l:levels = [0, 95, 135, 175, 215, 255]
  for l:r in l:levels
    for l:g in l:levels
      for l:b in l:levels
        call add(s:term_table, [l:r, l:g, l:b])
      endfor
    endfor
  endfor
  for l:i in range(24)
    let l:v = 8 + l:i * 10
    call add(s:term_table, [l:v, l:v, l:v])
  endfor
endfunction

function! s:rgb(hex) abort
  return [str2nr(a:hex[1:2], 16), str2nr(a:hex[3:4], 16), str2nr(a:hex[5:6], 16)]
endfunction

" mix a:fg into a:bg; a:pct is the share of a:fg (0.0 - 1.0)
" used for the soft background tints of Diff*/Error/Todo
function! s:mix(fg, bg, pct) abort
  let l:f = s:rgb(a:fg)
  let l:b = s:rgb(a:bg)
  let l:c = map([0, 1, 2], 'float2nr(round(l:f[v:val] * a:pct + l:b[v:val] * (1 - a:pct)))')
  return printf('#%02x%02x%02x', l:c[0], l:c[1], l:c[2])
endfunction

" nearest xterm-256 colour, used when the terminal has no truecolor
function! s:cterm(hex) abort
  if a:hex ==# '' || a:hex ==# 'NONE'
    return 'NONE'
  endif
  if has_key(s:term_cache, a:hex)
    return s:term_cache[a:hex]
  endif
  call s:build_term_table()
  let l:c = s:rgb(a:hex)
  let [l:best, l:bestd] = [0, 1.0e9]
  let l:i = 0
  for l:t in s:term_table
    let l:d = 2.0 * (l:t[0] - l:c[0]) * (l:t[0] - l:c[0])
          \ + 4.0 * (l:t[1] - l:c[1]) * (l:t[1] - l:c[1])
          \ + 3.0 * (l:t[2] - l:c[2]) * (l:t[2] - l:c[2])
    if l:d < l:bestd
      let [l:bestd, l:best] = [l:d, l:i]
    endif
    let l:i += 1
  endfor
  let s:term_cache[a:hex] = string(l:best)
  return s:term_cache[a:hex]
endfunction

" inkstone#Palette(['variant']) -> dict with the active palette
function! inkstone#Palette(...) abort
  let l:key = a:0 ? a:1 : get(g:, 'inkstone_current', 'xuanmo')
  if !has_key(s:palettes, l:key)
    let l:key = 'xuanmo'
  endif
  return s:palettes[l:key]
endfunction

function! inkstone#Names() abort
  return s:names
endfunction

function! inkstone#Variants() abort
  return sort(keys(s:names))
endfunction

function! s:hi(group, fg, bg, attr) abort
  let l:cmd = 'highlight ' . a:group
  if a:fg !=# ''
    let l:cmd .= ' guifg=' . a:fg
    if s:truecolor
      let l:cmd .= ' ctermfg=NONE'
    else
      let l:cmd .= ' ctermfg=' . s:cterm(a:fg)
    endif
  endif
  if a:bg !=# ''
    let l:cmd .= ' guibg=' . a:bg
    if s:truecolor
      let l:cmd .= ' ctermbg=NONE'
    else
      let l:cmd .= ' ctermbg=' . s:cterm(a:bg)
    endif
  endif
  let l:attr = a:attr ==# '' ? 'NONE' : a:attr
  execute l:cmd . ' gui=' . l:attr . ' cterm=' . l:attr
endfunction

" like s:hi but also sets the undercurl colour (guisp)
function! s:hi_ul(group, fg, bg, attr, sp) abort
  call s:hi(a:group, a:fg, a:bg, a:attr)
  execute 'highlight ' . a:group . ' guisp=' . a:sp
endfunction

function! s:link(from, to) abort
  execute 'highlight! link ' . a:from . ' ' . a:to
endfunction

function! inkstone#Apply(name) abort
  if !has_key(s:palettes, a:name)
    echohl ErrorMsg
    echomsg 'inkstone: unknown variant "' . a:name . '". Available: '
          \ . join(inkstone#Variants(), ', ')
    echohl None
    return
  endif

  let p = s:palettes[a:name]
  let g:inkstone_current = a:name

  let l:transparent = get(g:, 'inkstone_transparent', 0)
  let l:bg = l:transparent ? 'NONE' : p.bg
  " soft tints, so Diff*/Error never fall back to Vim's own red/blue/yellow
  let l:ins_bg = s:mix(p.ins, p.bg, 0.18)
  let l:chg_bg = s:mix(p.chg, p.bg, 0.18)
  let l:del_bg = s:mix(p.del, p.bg, 0.18)

  let &background = p.light ? 'light' : 'dark'
  highlight clear
  if exists('syntax_on')
    syntax reset
  endif
  " ':hi clear' unsets g:colors_name, so set it afterwards
  let g:colors_name = 'inkstone-' . a:name
  if get(g:, 'inkstone_termguicolors', 1) && has('termguicolors')
    set termguicolors
  endif
  let s:truecolor = has('termguicolors') && &termguicolors

  " ---------------------------------------------------------------- core
  call s:hi('Normal', p.fg, l:bg, '')
  call s:hi('NormalNC', p.comment, l:bg, '')
  call s:hi('Cursor', p.bg, p.cursor, '')
  call s:hi('lCursor', p.bg, p.cursor, '')
  call s:hi('TermCursor', p.bg, p.cursor, '')
  call s:hi('TermCursorNC', p.comment, p.bg, '')
  call s:hi('CursorLine', '', p.linehl, 'NONE')
  call s:hi('CursorColumn', '', p.linehl, 'NONE')
  call s:hi('ColorColumn', '', p.linehl, 'NONE')
  call s:hi('LineNr', p.lineno, p.gutter, '')
  call s:hi('LineNrAbove', p.lineno, p.gutter, '')
  call s:hi('LineNrBelow', p.lineno, p.gutter, '')
  call s:hi('CursorLineNr', p.lineno_act, p.linehl, 'bold')
  call s:hi('CursorLineSign', '', p.linehl, 'NONE')
  call s:hi('CursorLineFold', '', p.linehl, 'NONE')
  call s:hi('SignColumn', p.lineno, p.gutter, '')
  call s:hi('FoldColumn', p.comment, p.gutter, '')
  call s:hi('Folded', p.comment, p.widget, 'italic')
  call s:hi('VertSplit', p.border, l:bg, 'NONE')
  call s:hi('WinSeparator', p.border, l:bg, 'NONE')
  call s:hi('Visual', 'NONE', p.sel, 'NONE')
  call s:hi('VisualNOS', 'NONE', p.sel_nc, 'NONE')
  call s:hi('Search', p.bg, p.findbd, 'bold')
  call s:hi('IncSearch', p.bg, p.cursor, 'bold')
  call s:hi('CurSearch', p.bg, p.cursor, 'bold')

function! inkstone#List() abort
  for l:k in inkstone#Variants()
    echomsg printf('%-16s %s', l:k, s:names[l:k])
  endfor
endfunction

" ---------------------------------------------------------------- helpers
" airline 在 truecolor 下只用 gui 颜色，没必要算 cterm 近似值
function! inkstone#Cterm(hex) abort
  return s:truecolor ? '' : s:cterm(a:hex)
endfunction

" ---------------------------------------------------------------- commands
function! inkstone#Complete(A, L, P) abort
  return filter(inkstone#Variants(), 'v:val =~# "^" . a:A')
endfunction

function! inkstone#Command(arg) abort
  if a:arg ==# '' || a:arg ==# 'list'
    call inkstone#List()
    return
  endif
  if index(inkstone#Variants(), a:arg) >= 0
    execute 'colorscheme inkstone-' . a:arg
  else
    echohl ErrorMsg
    echomsg 'inkstone: unknown variant "' . a:arg . '". Available: ' . join(inkstone#Variants(), ', ')
    echohl None
  endif
endfunction

